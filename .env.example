# Copy to .env for local development. Never commit real secrets.
PORT=3000
NODE_ENV=development
FIREBASE_PROJECT_ID=your-firebase-project-id

# Comma-separated exact browser origins permitted by CORS.
LAPER_ORIGINS=https://your-laper-site.example

# Provider keys stay on the server. Leave blank until you have a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fast mode makes one call to this provider; there is no fallback.
FAST_PROVIDER=gemini
REQUEST_TIMEOUT_MS=30000
MAX_REQUESTS_PER_MINUTE=20
MAX_BODY_BYTES=32768
